# Salin menjadi .env.local.
# Untuk PostgreSQL lokal, biarkan nilai ini seperti di bawah.
# Untuk Neon, ganti dengan connection string lengkap dari Neon Console.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/civicreport

# Ganti dengan string acak panjang untuk menandatangani sesi.
SESSION_SECRET=replace-with-a-long-random-secret
